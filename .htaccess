Options -Indexes
ServerSignature Off
# never serve databases, logs, backups, archives, config or hidden files
<FilesMatch "\.(sqlite|sqlite3|db|log|sql|bak|old|orig|swp|zip|tar|gz|7z|rar|sh|ini|env|lock|md|yml|yaml|dist)$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Security headers (HTTPS only, no framing by other sites, no MIME sniffing, limited browser features)
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "same-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(self), microphone=(), payment=(), usb=(), bluetooth=(), interest-cohort=()"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|PUT|DELETE|PATCH)$ [NC]
  RewriteRule .* - [F,L]
</IfModule>
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RedirectMatch 404 /\.git
<FilesMatch "^\.(gitignore|git.*)$">
  Require all denied
</FilesMatch>

# Speed: compress text, cache static assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType text/css "access plus 5 minutes"
  ExpiresByType application/javascript "access plus 5 minutes"
  ExpiresByType text/javascript "access plus 5 minutes"
</IfModule>
<FilesMatch "api\.php$">
  Header set Cache-Control "no-store"
</FilesMatch>
# the app shell is always re-checked (a quick 304), so a new ?v= on the scripts reaches staff at once while the scripts themselves stay cached
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache"
  # the page may only load its own scripts, styles and pictures, cannot be framed by another site, and a window it opens cannot reach back into it
  Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; frame-src 'self' https://www.openstreetmap.org; object-src 'self'; base-uri 'self'; form-action 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header set Cross-Origin-Opener-Policy "same-origin-allow-popups"
</FilesMatch>

# Speed: scripts and styles are loaded as file?v=<stamp>, and the stamp changes with every update - so a stamped file never changes
# and the browser may keep it for a year without asking the server again
<IfModule mod_rewrite.c>
  RewriteCond %{QUERY_STRING} (^|&)v=[0-9]+
  RewriteRule \.(js|css)$ - [E=LONGCACHE:1]
</IfModule>
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=LONGCACHE
</IfModule>

# Home-screen app manifest (iPhone / iPad / Android)
AddType application/manifest+json .webmanifest

# the service worker file is always re-checked
<FilesMatch "^sw\.js$">
  Header set Cache-Control "no-cache"
</FilesMatch>
