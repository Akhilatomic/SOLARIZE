Options -Indexes
ServerSignature Off
# never serve databases, logs, backups, archives, config or hidden files
<FilesMatch "\.(sqlite|sqlite3|db|log|sql|bak|old|orig|swp|zip|tar|gz|7z|rar|sh|ini|env|lock|md|yml|yaml|dist)$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Security headers (HTTPS only, no framing by other sites, no MIME sniffing, limited browser features)
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "same-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(self), microphone=(), payment=(), usb=(), bluetooth=(), interest-cohort=()"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|PUT|DELETE|PATCH)$ [NC]
  RewriteRule .* - [F,L]
</IfModule>
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RedirectMatch 404 /\.git
<FilesMatch "^\.(gitignore|git.*)$">
  Require all denied
</FilesMatch>

# Speed: compress text, cache static assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType text/css "access plus 5 minutes"
  ExpiresByType application/javascript "access plus 5 minutes"
  ExpiresByType text/javascript "access plus 5 minutes"
</IfModule>
<FilesMatch "api\.php$">
  Header set Cache-Control "no-store"
</FilesMatch>
# the app shell is always re-checked (a quick 304), so a new ?v= on the scripts reaches staff at once while the scripts themselves stay cached
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache"
</FilesMatch>

# Home-screen app manifest (iPhone / iPad / Android)
AddType application/manifest+json .webmanifest
